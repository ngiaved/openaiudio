# --- OpenAIudio configuration (all optional) -----------------------------
# Copy to .env or export in the environment. Values are documented in this guide.

# Gemini API key (Google AI Studio). Required unless you use PROVIDER=mock.
# Without a key, PROVIDER=auto falls back to mock (offline demo, no cost).
GEMINI_API_KEY=

# --- Vendors ---------------------------------------------------------------
# Vendors provide STT + translation models. Every vendor reads its API key from
# the env; without a key the vendor is auto-disabled. ENABLED_VENDORS lets you
# turn whole vendors on/off (comma-separated ids); empty = all vendors on.
# Built-in ids: gemini, xai, openai, anthropic, groq, mistral, deepseek,
#               together, openrouter, azure_openai, local, mock
ENABLED_VENDORS=

XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Custom vendors are configured from the /vendors admin page and persisted to
# data/vendors.json (gitignored). They share the same features as built-ins.

# Default provider when creating sessions: auto | gemini | local | mock
#   auto  -> gemini if an API key is configured, otherwise mock (offline demo).
PROVIDER=auto

# Default translation pathway: audio | text | auto
#   auto  -> text for gemini/local (robust and cheap);
#            audio for mock (demo with the same flavor as the live pathway).
TRANSLATION_MODE=auto

# --- REQUIRED Gemini models for the cloud provider to work ---------------
# GEMINI_MODEL: used for the original's windowed STT (inline audio -> text).
# GEMINI_TEXT_MODEL: used for text->text translations. If unset, it defaults
#   to GEMINI_MODEL. Both must be models that exist on the API key(s) / account
#   and that support generateContent (text output). A wrong/missing model makes
#   every request fail and no captions are produced.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Experimental *live* model (TRANSLATION_MODE=audio with provider gemini).
# These are preview models; today we prioritize windowed STT.
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Audio window for windowed STT (seconds) and how often it is transcribed.
STT_WINDOW_SEC=6.5
STT_STEP_SEC=5.0

# dBFS RMS floor the window must beat to be transcribed (silence skips
# requests to save quota). -60 only skips digital silence; -36 is safe for
# loud inputs but can starve a quiet laptop mic.
STT_MIN_ENERGY_DB=-60

# Simultaneous-provider and session limits.
MAX_PROVIDERS=80
MAX_SESSIONS=64

# Pause a session's providers after N seconds without audio (saves cost).
IDLE_TIMEOUT_SEC=180

# If set, writes caption feeds for OBS/vMix to this directory.
# E.g. OBS_OUT_DIR=./data/obs
OBS_OUT_DIR=

# Local routing (PROVIDER=local):
#   whisper model: tiny | base | small | medium | large-v3 | distil-large-v3
#   (see docs/LOCAL_WHISPER.md for per-OS setup and optional CUDA)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
#   Gemma 3 for translation via Ollama (requires `ollama serve` + `ollama pull gemma3:4b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Server host/port for the quickstart guide.
HOST=0.0.0.0
PORT=8000