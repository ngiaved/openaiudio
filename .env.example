# --- OpenAIudio configuration (all optional) -----------------------------
# Copiá a .env o exportá por entorno. Los valores aquí se documentan en esta guía.

# Gemini API key (Google AI Studio). Requerida salvo que uses PROVIDER=mock.
# Sin key, PROVIDER=auto cae en mock (demo offline sin costo).
GEMINI_API_KEY=

# Proveedor por defecto al crear sesiones: auto | gemini | local | mock
#   auto  -> gemini si hay API key configurada, si no mock (demo offline).
PROVIDER=auto

# Vía de traducción por defecto: audio | text | auto
#   auto  -> text para gemini/local (robusto y económico);
#            audio para mock (demo con el mismo sabor que la vía live).
TRANSLATION_MODE=auto

# Modelo de generar contenido (Gemini): lo usa el STT del original (audio por
# ventanas -> texto) y, si no se define GEMINI_TEXT_MODEL, las traducciones.
GEMINI_MODEL=gemini-3.8-flash

# Modelo de texto para traducciones (topología híbrida por texto).
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Modelo *live* experimental (TRADUCCIÓN_MODE=audio con provider gemini).
# Son modelos preview; hoy priorizamos el STT por ventanas.
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Ventana de audio del STT por ventanas (segundos) y cada cuánto se transcribe.
STT_WINDOW_SEC=6.5
STT_STEP_SEC=5.0

# Piso de dBFS RMS la ventana debe superar para transcribir (silencios evitan
# requests). Antes era 33 (mal: dB negativos); -36 funciona para voz normal.
STT_MIN_ENERGY_DB=-36

# Límite de providers simultáneos y de sesiones.
MAX_PROVIDERS=80
MAX_SESSIONS=64

# Detener providers de una sesión sin audio tras N segundos (ahorra costo).
IDLE_TIMEOUT_SEC=180

# Si se setea, escribe feeds de subtítulos para OBS/vMix en este directorio.
# Ej: OBS_OUT_DIR=./data/obs
OBS_OUT_DIR=

# Rute local (PROVIDER=local):
#   whisper base model (small | base | tiny | turbo)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
#   Gemma 3 para traducción vía Ollama (requiere `ollama serve` + `ollama pull gemma3:4b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Puerto/host del servidor en la guía rápida.
HOST=0.0.0.0
PORT=8000